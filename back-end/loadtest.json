{
    "config": {
        "target": "http://localhost:3000",
        "phases": [
            {
                "duration": 60,
                "arrivalRate": 5
            }
        ],
        "defaults": {
            "headers": {
                "Content-Type": "application/json"
            }
        }
    },
    "scenarios": [
        {
            "name": "Solve Page Scenario",
            "flow": [
                {
                    "post": {
                        "url": "/api/v1/auth/login",
                        "json": {
                            "email": "insite@naver.com",
                            "password": "insite1234"
                        },
                        "capture": {
                            "json": "$.accessToken",
                            "as": "token"
                        }
                    }
                },
                {
                    "get": {
                        "url": "/api/v1/problems",
                        "headers": {
                            "Authorization": "Bearer {{ token }}"
                        },
                        "capture": {
                            "json": "$.problems[0].id",
                            "as": "problemId"
                        }
                    }
                },
                {
                    "get": {
                        "url": "/api/v1/problems/{{ problemId }}",
                        "headers": {
                            "Authorization": "Bearer {{ token }}"
                        }
                    }
                },
                {
                    "post": {
                        "url": "/api/v1/code",
                        "headers": {
                            "Authorization": "Bearer {{ token }}"
                        },
                        "json": {
                            "problemId": "{{ problemId }}",
                            "code": "print('Hello World')",
                            "language": "python"
                        }
                    }
                }
            ]
        }
    ]
}